
<% if User.current.allowed_to?(:edit_issues, @project ,:global=> true ) || User.current.allowed_to?(:add_issues, @project , :global=> true ) || User.current.admin? %>


<% if @project %>
  <% users = @project.users.active.joins(:email_address).where.not(email_addresses: { address: [nil, ""] }).distinct.select("users.id", "users.login") %>
<% else %>
  <% users = User.active.joins(:email_address).where.not(email_addresses: { address: [nil, ""] }).select("users.id", "users.login") %>
<% end %>




<% users_data = users.map { |user| { id: user.id, login: user.login } }.to_json %>
<% symbol = Setting.plugin_flux_mentions['symbol'] %>

<script>


$(document).ready(function() {
  var usersData = <%= users_data.html_safe %>;
  var symbol = '<%= symbol %>';

  // Redmine core already attaches its own Tribute-based autocomplete for '#' (issues),
  // '[[' (wiki pages) and '@' (users) on focus of these same textareas, guarded by a
  // data-tribute flag so it only attaches once. Attaching our own Tribute instance here
  // unconditionally on page load sets that flag first, so core's autocomplete never
  // attaches when the field is later focused -- silently killing the '#' and '[[' menus.
  // Core already covers '@' correctly, so skip ours for the default symbol.
  if (symbol === '@') {
    return;
  }

  var tributed = new Tribute({
    values: usersData,
    lookup: 'login',
    fillAttr: 'login',
     requireLeadingSpace: 'true',
    selectTemplate: function(item) {
      return symbol + item.original.login;
    },

    trigger: symbol 
    
  });



   var $descriptionTextarea = $('textarea#issue_description');
   tributed.attach($descriptionTextarea);  
  // $descriptionTextarea.on('keydown', function(event) {
  //   if (event.key === symbol   ) {
      
  //     //tributed.detach($descriptionTextarea,[0]);
  //     // this.focus();
  //     // tributed.showMenuForCollection(this, false); 
  //     tributed.attach($descriptionTextarea,[0]);   
  //   } 

  // });
// ---------



// --------


    var $notesTextarea = $('textarea#issue_notes');
    tributed.attach($notesTextarea); 

  //  $notesTextarea.on('keydown', function(event) {
  //   if (event.key === symbol  ) {
  //     //tributed.attach($notesTextarea,[0]);
  //     // this.focus();
  //     // tributed.showMenuForCollection(this, false);
  //     tributed.attach($notesTextarea,[0]);
  //      }   
  //   });
  });




</script>
